# ---- Required ----
PORT=5000
# MongoDB Atlas (or any REPLICA SET) - multi-document transactions need a replica set
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# ---- Optional ----
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (required for a deployed frontend)
CORS_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind a proxy (Render/Railway/Heroku) so rate limiting sees real client IPs
TRUST_PROXY=0
# Dev-only helpers (time travel for missed-day tests). Ignored when NODE_ENV=production.
ENABLE_DEV_TOOLS=false
